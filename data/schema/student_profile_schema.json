{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-step-zero/schema/student_profile_schema.json",
  "title": "Project Step Zero Synthetic Student Profile",
  "description": "Schema for a single synthetic learner profile. The shape matches Student.to_dict() so profiles load through the existing Student.from_dict() deserializer, with an additional metadata block that records the profile as synthetic research material rather than observed data.",
  "type": "object",
  "required": ["student_id", "name", "created_at", "metadata", "progress", "history"],
  "additionalProperties": false,
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Stable identifier, also used as the deterministic generation seed.",
      "pattern": "^[a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "metadata": {
      "$ref": "#/$defs/profile_metadata"
    },
    "progress": {
      "type": "object",
      "description": "Concept id -> per-concept progress record.",
      "additionalProperties": { "$ref": "#/$defs/concept_progress" }
    },
    "history": {
      "type": "array",
      "items": { "$ref": "#/$defs/learning_event" }
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
    },
    "nullable_timestamp": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?$"
    },
    "unit_interval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "profile_metadata": {
      "type": "object",
      "description": "Provenance for the profile. The synthetic flag and disclaimer are required so a generated persona can never be mistaken for observed student data.",
      "required": ["synthetic", "persona", "description", "disclaimer", "generator_version"],
      "additionalProperties": true,
      "properties": {
        "synthetic": {
          "const": true,
          "description": "Always true. These profiles are designed personas, not measurements of real learners."
        },
        "persona": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "disclaimer": {
          "type": "string",
          "minLength": 1
        },
        "generator_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "design_notes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "concept_progress": {
      "type": "object",
      "required": ["concept_id", "status", "mastery_score", "attempts", "time_spent_hours"],
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){2,}$"
        },
        "status": {
          "type": "string",
          "enum": ["not_started", "in_progress", "mastered"]
        },
        "mastery_score": { "$ref": "#/$defs/unit_interval" },
        "attempts": {
          "type": "integer",
          "minimum": 0
        },
        "time_spent_hours": {
          "type": "number",
          "minimum": 0
        },
        "self_rated_confidence": {
          "anyOf": [
            { "$ref": "#/$defs/unit_interval" },
            { "type": "null" }
          ]
        },
        "first_studied_at": { "$ref": "#/$defs/nullable_timestamp" },
        "last_reviewed_at": { "$ref": "#/$defs/nullable_timestamp" },
        "completed_at": { "$ref": "#/$defs/nullable_timestamp" }
      }
    },
    "learning_event": {
      "type": "object",
      "required": ["concept_id", "event_type", "timestamp"],
      "additionalProperties": false,
      "properties": {
        "concept_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+){2,}$"
        },
        "event_type": {
          "type": "string",
          "enum": ["started", "attempted", "mastered", "reviewed"]
        },
        "timestamp": { "$ref": "#/$defs/timestamp" },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
